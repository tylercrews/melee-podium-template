# Copy this file to .env in the Flask application root (outside public_html).
# Never commit .env or put real credentials in browser code.
#
# Choose the credential type used by the eventual server-side Challonge client.
CHALLONGE_CLIENT_ID=replace-with-rotated-client-id
CHALLONGE_CLIENT_SECRET=replace-with-rotated-client-secret
CHALLONGE_API_KEY=replace-with-rotated-api-v1-key
START_GG_TOKEN=melee-podium-template-token
PARRY_GG_API_KEY=replace-with-parry-gg-api-key

# Firebase Admin uses Application Default Credentials. Point this at the
# service-account JSON outside the repository; never paste the JSON here.
GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/to/firebase-admin.json
# Optional on hosted deployments: override the default secrets dotenv file in
# the account home directory. The file must remain outside the public web root.
# PODIUM_SECRETS_FILE=/absolute/path/to/server-secrets.env
# Copy the exact bucket name from Firebase Console > Storage. Newer default
# buckets commonly end in .firebasestorage.app; older ones may use .appspot.com.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Optional: add the network lookup required to reject revoked tokens immediately.
FIREBASE_CHECK_REVOKED_TOKENS=false
# Optional per-image upload ceiling (default: 20 MiB).
FIREBASE_MAX_IMAGE_BYTES=20971520
