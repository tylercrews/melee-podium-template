# Firebase Web SDK values are public client configuration, not Admin credentials.
# Find them in Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id

# Optional when the Flask API is hosted somewhere other than this frontend.
# VITE_API_BASE_URL=https://example.com/api/
